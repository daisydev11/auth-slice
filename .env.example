# Copy this file to .env and fill in the values by hand. Never commit .env.

# PostgreSQL connection string. From your Neon/Supabase project settings,
# or a local Postgres. The ?schema=auth part keeps this slice in its own schema.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=auth"
DATABASE_URL=

# Public base URL of the app, used to build the password reset link.
# APP_URL="http://localhost:3000"
APP_URL=

# Resend API key (https://resend.com/api-keys). Leave empty in local
# development: emails are then printed to the server terminal instead of sent.
# RESEND_API_KEY="re_xxxxxxxx"
RESEND_API_KEY=

# The "from" address for emails. Must be on a domain verified in Resend,
# or "onboarding@resend.dev" while testing.
# EMAIL_FROM="Auth Slice <onboarding@resend.dev>"
EMAIL_FROM=
